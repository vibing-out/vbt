{
  "model": "opus",
  "permissions": {
    "deny": [
      "Bash(*supabase db push*)",
      "Bash(*supabase db reset*)",
      "Bash(*supabase migration up*)",
      "Bash(*supabase migration repair*)",
      "Bash(*vercel env add*)",
      "Bash(*vercel env rm*)",
      "Bash(*vercel env update*)",
      "Bash(*vercel deploy*)",
      "Bash(*vercel --prod*)",
      "Bash(*vercel promote*)",
      "Bash(*vercel rollback*)",
      "Bash(*git push --force*)",
      "Bash(*git push -f *)",
      "Bash(*git push*origin main*)",
      "Bash(*git push*origin HEAD:main*)",
      "Bash(*gh pr merge*--admin*)",
      "Bash(*gh repo delete*)",
      "Bash(*gh repo edit*--visibility*)",
      "Bash(*gh api*branches/main/protection*)",
      "Bash(*rm -rf /*)",
      "Bash(*rm -rf ~*)",
      "Bash(*git push*origin epic/*)",
      "Bash(*git push*origin HEAD:epic/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\""
          }
        ]
      }
    ]
  }
}
