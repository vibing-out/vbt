# Every variable the app needs, names only. Real values live in .env.local (git-ignored).
# Adding a variable? Add it here in the same pull request, or `pnpm run doctor` fails for your teammate.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Context log (Supabase project vbt-context-log), read server-side by the web app. Never NEXT_PUBLIC_.
CONTEXT_SUPABASE_URL=
CONTEXT_SUPABASE_PUBLISHABLE_KEY=
CONTEXT_EMAIL=
CONTEXT_PASSWORD=
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
# Vercel Flags: the SDK key the adapter reads, and the secret for flag overrides. `vercel env pull` fills both.
FLAGS=
FLAGS_SECRET=
# Local Postgres for the supabase/ database tests (localhost only), e.g. from `supabase start`:
# postgresql://postgres:postgres@localhost:54322/postgres. CI sets it for its Postgres service.
DATABASE_URL=
# Slack incoming webhook for the team channel. The factory reads it from the SLACK_WEBHOOK_URL repository
# secret to post issues labeled needs-human. Commented out because no app code reads it and `pnpm run doctor`
# would demand it locally; uncomment it in .env.local only to try `node scripts/factory/dispatch.ts notify <issue>`.
# SLACK_WEBHOOK_URL=
# Election crypto keys (base64, libsodium). The real values live only in Vercel (Production and Preview); the two
# secret keys are Sensitive, so `vercel env pull` does not fetch them. Commented out so `pnpm run doctor` doesn't
# demand them; for local work on the APIs, uncomment them in .env.local with throwaway keys you generate yourself,
# never the real ones. Public keys: sealed-box encryption and stage-record signature checks. Secret keys: aggregate
# tally decryption and stage-record signing (server only; never prefix them with NEXT_PUBLIC_).
# ELECTION_PUBLIC_KEY=
# ELECTION_SECRET_KEY=
# STAGE_SIGNING_PUBLIC_KEY=
# STAGE_SIGNING_SECRET_KEY=
# T-20 demo officials (optional, commented so `pnpm run doctor` does not require them): e2e sign-in on a
# preview deploy, and the optional inputs of supabase/scripts/seed-demo-officials.ts. Real values live only
# in Vercel and Warp secrets (the seed script prints passwords and TOTP secrets once); never commit them.
#   DEMO_POLL_WORKER_EMAIL=
#   DEMO_POLL_WORKER_PASSWORD=
#   DEMO_POLL_WORKER_TOTP_SECRET=
#   DEMO_COUNTY_EMAIL=
#   DEMO_COUNTY_PASSWORD=
#   DEMO_COUNTY_TOTP_SECRET=
#   DEMO_STATE_EMAIL=
#   DEMO_STATE_PASSWORD=
#   DEMO_STATE_TOTP_SECRET=
# PLAYWRIGHT_BASE_URL (optional, per run, never in .env.local: Playwright loads .env.local, so every local
# e2e run would go to that deploy): runs the e2e specs against a deployed app instead of a local build, e.g.
#   PLAYWRIGHT_BASE_URL=https://<preview>.vercel.app pnpm --filter web test:e2e
# VERCEL_AUTOMATION_BYPASS_SECRET (optional, commented so `pnpm run doctor` does not require it): Vercel
# Protection Bypass for Automation (Vercel project settings > Deployment Protection). Lets the e2e specs
# reach a protected preview instead of its SSO redirect; sent as x-vercel-protection-bypass only when set.
# A secret: real values live only in Vercel and Warp secrets.
#   VERCEL_AUTOMATION_BYPASS_SECRET=
