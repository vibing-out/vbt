{
  "name": "@vbt/scale-demo",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/fake-crypto.ts",
    "./testing/db": "./src/testing/scratch-db.ts"
  },
  "scripts": {
    "seed": "pnpm --filter @vbt/crypto build && node src/cli.ts",
    "typecheck": "pnpm --filter @vbt/crypto build && tsc --noEmit",
    "test": "pnpm --filter @vbt/crypto build && vitest run"
  },
  "dependencies": {
    "@vbt/crypto": "workspace:*",
    "@vbt/domain": "workspace:*",
    "@vbt/events": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@vbt/supabase": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
