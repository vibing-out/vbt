      "additionalProperties": false,
      "properties": {
        "@type": {
          "enum": [
            "CVR.SelectionPosition"
          ],
          "type": "string"
        },
        "HasIndication": {
          "$ref": "#/definitions/CVR.IndicationStatus"
        },
        "IsAllocable": {
